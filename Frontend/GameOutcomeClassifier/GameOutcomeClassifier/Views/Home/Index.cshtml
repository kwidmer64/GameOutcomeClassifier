@{
    ViewData["Title"] = "Home Page";
}

@model GameOutcomeClassifier.Models.ViewModels.PredictionViewModel;

@{
    PredictionResult? predictionResult = Model.Result;
    Dictionary<string, string> teams = Model.Teams;
}

<div class="main-panel">

    @* Team selector form *@
    <div class="panel-form-section">
        <form method="post" class="predict-form d-flex align-items-center justify-content-center flex-wrap">
            <select name="homeTeam" id="homeTeam" class="predict-select">
                @foreach (var item in teams)
                {
                    <option value="@item.Key">@item.Value</option>
                }
            </select>
            <span class="vs-divider">VS</span>
            <select name="awayTeam" id="awayTeam" class="predict-select">
                @foreach (var item in teams)
                {
                    <option value="@item.Key">@item.Value</option>
                }
            </select>
            <button asp-controller="Home" asp-action="Predict" type="submit" class="predict-btn">Predict</button>
        </form>
    </div>

    @* Results *@
    @if (predictionResult != null)
    {
        string homeWinClass = predictionResult.Winner == predictionResult.HomeTeam ? "winner" : "loser";
        string awayWinClass = predictionResult.Winner == predictionResult.AwayTeam ? "winner" : "loser";

        int awayRowCount = predictionResult.AwayScoreProbabilities.Count;
        int homeColCount = predictionResult.HomeScoreProbabilities.Count;

        double maxProb = 0;
        foreach (var h in predictionResult.HomeScoreProbabilities)
        {
            foreach (var a in predictionResult.AwayScoreProbabilities)
            {
                if (h.Value * a.Value > maxProb)
                {
                    maxProb = h.Value * a.Value;
                }
            }
        }

        double maxHomeProb = predictionResult.HomeScoreProbabilities.Values.Max();
        double maxAwayProb = predictionResult.AwayScoreProbabilities.Values.Max();

        @* Matchup header *@
        <div class="panel-matchup-section">
            <div class="matchup-header d-flex align-items-stretch justify-content-center">
                <span class="team-display @homeWinClass">@predictionResult.HomeTeam</span>
                <div class="matchup-center d-flex flex-column justify-content-between align-items-center">
                    <span class="win-label">@predictionResult.Winner wins</span>
                    <div class="confidence-block d-flex flex-column align-items-center">
                        <span class="confidence-value">@((predictionResult.Confidence * 100).ToString("F0"))%</span>
                        <span class="confidence-tag">prediction confidence</span>
                    </div>
                </div>
                <span class="team-display @awayWinClass">@predictionResult.AwayTeam</span>
            </div>
        </div>

        @* Score probability matrix + individual probabilities *@
        <div class="panel-matrix-section">
            <div class="matrix-and-probs d-flex align-items-start justify-content-center flex-wrap">

                @* Matrix *@
                <div class="matrix-container flex-shrink-0">
                    <div class="matrix-layout d-flex flex-column">
                        <div class="matrix-body d-flex align-items-center">
                            <div class="matrix-row-label">@predictionResult.AwayTeam</div>
                            <div class="matrix-right d-flex flex-column">
                                <div class="matrix-col-label">@predictionResult.HomeTeam</div>
                                <div class="score-matrix-wrapper">
                                    <table class="score-matrix">
                                        <thead>
                                            <tr>
                                                <th class="sm-corner"></th>
                                                @foreach (var homeBucket in predictionResult.HomeScoreProbabilities)
                                                {
                                                    <th class="sm-home-bucket">@homeBucket.Key</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var away in predictionResult.AwayScoreProbabilities)
                                            {
                                                <tr>
                                                    <td class="sm-row-bucket">@away.Key</td>
                                                    @foreach (var home in predictionResult.HomeScoreProbabilities)
                                                    {
                                                        double prob = home.Value * away.Value;
                                                        double intensity = maxProb > 0 ? prob / maxProb : 0;
                                                        int r = (int)(15  + intensity * (16  - 15));
                                                        int g = (int)(23  + intensity * (185 - 23));
                                                        int b = (int)(42  + intensity * (129 - 42));
                                                        string textAlpha = (0.35 + intensity * 0.65).ToString("F2");
                                                        string textColor = $"rgba(255,255,255,{textAlpha})";
                                                        <td class="sm-cell" style="background:rgb(@r,@g,@b);color:@textColor">
                                                            @((prob * 100).ToString("F0"))%
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Individual score probabilities *@
                <div class="prob-comparison-container flex-shrink-0">
                    <div class="matrix-col-label prob-align-spacer" aria-hidden="true">&nbsp;</div>
                    <table class="prob-comparison-table">
                        <thead>
                            <tr>
                                <th class="sm-corner"></th>
                                <th class="prob-team-header">@predictionResult.HomeTeam</th>
                                <th class="prob-team-header">@predictionResult.AwayTeam</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bucket in predictionResult.HomeScoreProbabilities)
                            {
                                predictionResult.AwayScoreProbabilities.TryGetValue(bucket.Key, out double awayProb);
                                double hi = maxHomeProb > 0 ? bucket.Value / maxHomeProb : 0;
                                double ai = maxAwayProb > 0 ? awayProb / maxAwayProb : 0;
                                int hr = (int)(15 + hi * (16  - 15)); int hg = (int)(23 + hi * (185 - 23)); int hb = (int)(42 + hi * (129 - 42));
                                int ar = (int)(15 + ai * (16  - 15)); int ag = (int)(23 + ai * (185 - 23)); int ab = (int)(42 + ai * (129 - 42));
                                string hAlpha = (0.35 + hi * 0.65).ToString("F2");
                                string aAlpha = (0.35 + ai * 0.65).ToString("F2");
                                <tr>
                                    <td class="sm-row-bucket">@bucket.Key</td>
                                    <td class="prob-cell" style="background:rgb(@hr,@hg,@hb);color:rgba(255,255,255,@hAlpha)">@((bucket.Value * 100).ToString("F0"))%</td>
                                    <td class="prob-cell" style="background:rgb(@ar,@ag,@ab);color:rgba(255,255,255,@aAlpha)">@((awayProb * 100).ToString("F0"))%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
</div>
