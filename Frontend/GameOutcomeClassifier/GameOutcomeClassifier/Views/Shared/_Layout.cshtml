<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400;600&family=Rajdhani:wght@500;600&display=swap" rel="stylesheet">
    <title>@ViewData["Title"] - FinalWhistle</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GameOutcomeClassifier.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="site-nav">
            <div class="site-nav-inner">
                <a class="site-brand" asp-area="" asp-controller="Home" asp-action="Index">FinalWhistle</a>
                <div class="sport-tabs">
                    <a class="sport-tab sport-tab--active" asp-area="" asp-controller="Home" asp-action="Index">NFL</a>
                    <span class="sport-tab sport-tab--soon">NBA</span>
                    <span class="sport-tab sport-tab--soon">MLB</span>
                    <span class="sport-tab sport-tab--soon">Soccer</span>
                    <span class="sport-tab sport-tab--soon">Esports</span>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer-inner">
            <span class="site-footer-text">&copy; 2026 FinalWhistle</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
